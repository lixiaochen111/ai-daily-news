# AI Content Filtering System Configuration
# Documentation: docs/superpowers/specs/2026-05-17-ai-content-filtering-design.md

# ============================================================================
# API Keys
# ============================================================================

# Zhipu AI - GLM-4.7-Flash (Free Tier)
# Default: Built-in shared API key (all users share free quota)
# Optional: Configure your own key for dedicated quota
# Get from: https://open.bigmodel.cn/
# Used for: Fast classification (Tier 2 initial screening)
# Leave empty to use default shared key
GLM_API_KEY=

# EasyRouter - Multi-model Access
# Required: Configure your own API key
# Get from: https://easyrouter.ai/
# Used for: Deep analysis (DeepSeek for Chinese, GPT-4o Mini for English)
# Cost: ~¥0.08-0.25/day
EASYROUTER_API_KEY=your_easyrouter_api_key_here
EASYROUTER_BASE_URL=https://api.easyrouter.ai/v1

# ============================================================================
# AI Filter Control
# ============================================================================

# AI Filter Toggle (Optional, defaults to 0)
# Set to 1 to enable AI-powered content filtering
AI_FILTER_ENABLED=1

# ============================================================================
# Model Configuration (Optional)
# ============================================================================

# Tier 2 Classification Model (free)
AI_MODEL_CLASSIFY=glm-4.7-flash

# Deep Analysis Models (paid)
AI_MODEL_ANALYZE_ZH=deepseek-chat    # Chinese content
AI_MODEL_ANALYZE_EN=gpt-4o-mini      # English content
