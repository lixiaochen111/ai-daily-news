# AI Content Filtering System Configuration
# Documentation: docs/superpowers/specs/2026-05-17-ai-content-filtering-design.md
# Get API key from: https://easyrouter.ai/

# EasyRouter Configuration (Required when AI_FILTER_ENABLED=1)
EASYROUTER_API_KEY=your_api_key_here
EASYROUTER_BASE_URL=https://api.easyrouter.ai/v1

# AI Filter Toggle (Optional, defaults to 0)
# Set to 1 to enable AI-powered content filtering
AI_FILTER_ENABLED=1

# Model Configuration (Optional, uses these defaults)
# GLM-4-Flash: Free tier classification model
# DeepSeek-Chat: Chinese content analysis
# GPT-4o-Mini: English content analysis
AI_MODEL_CLASSIFY=glm-4-flash
AI_MODEL_ANALYZE_ZH=deepseek-chat
AI_MODEL_ANALYZE_EN=gpt-4o-mini
